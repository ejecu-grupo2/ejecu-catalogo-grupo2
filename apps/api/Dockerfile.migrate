# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine3.23@sha256:78e7f1e419545bc4b8b5ee8a40a99ddb5df1216d38681dbab2eeb1fdb2427f43 AS build
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go install github.com/pressly/goose/v3/cmd/goose@v3.24.1
FROM alpine:3.23.7@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
WORKDIR /app
COPY --from=build /go/bin/ /usr/local/bin/
COPY --chown=65532:65532 apps/api/db/migrations/ /app/db/migrations/
USER 65532:65532
ENTRYPOINT ["goose", "-dir", "/app/db/migrations", "postgres"]
CMD ["up"]
